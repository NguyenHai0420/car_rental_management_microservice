# MinIO credentials belong to the API inside services/minio-service. Its Compose settings are in services/minio-service/.env.example.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
FILE_SERVICE_URL=http://localhost:8087
FILE_SERVICE_VEHICLE_API_KEY=local-vehicle-file-service-key
FILE_SERVICE_CUSTOMER_API_KEY=local-customer-file-service-key
VEHICLE_IMAGE_BUCKET=vehicle-images
VEHICLE_DOCUMENT_BUCKET=vehicle-documents
VEHICLE_PRESIGN_EXPIRY=10m
VEHICLE_MEDIA_MANAGEMENT_ROLES=ADMIN,STAFF
DB_URL=jdbc:mysql://localhost:3306/vehicle_db
DB_USERNAME=root
DB_PASSWORD=1234
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Shared trust credentials: set the same value in the named service and its callers.
MAINTENANCE_GATEWAY_SECRET=replace-with-a-local-maintenance-secret
NOTIFICATION_GATEWAY_SECRET=replace-with-a-local-notification-secret
NOTIFICATION_INTERNAL_TOKEN=replace-with-a-local-booking-notification-token
NOTIFICATION_SERVICE_URL=http://localhost:8086

# Dedicated settings for the maintenance and notification services.
# The root Docker Compose publishes MySQL on port 3307.
MAINTENANCE_DB_URL=jdbc:mysql://localhost:3307/maintenance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
MAINTENANCE_DB_USERNAME=root
MAINTENANCE_DB_PASSWORD=1234
NOTIFICATION_DB_URL=jdbc:mysql://localhost:3307/notification_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
NOTIFICATION_DB_USERNAME=root
NOTIFICATION_DB_PASSWORD=1234
# Use update for a new local database; the services default to schema validation.
JPA_DDL_AUTO=update

# Configure payment-provider credentials locally.
SEPAY_API_KEY=
SEPAY_API_TOKEN=
