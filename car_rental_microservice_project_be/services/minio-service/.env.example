MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HTTP_PORT=8087
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_DATA_VOLUME=car-rental-minio-data
MINIO_NETWORK=car-rental-storage
# Comma-separated bucket names, without spaces. An empty list is allowed.
MINIO_PUBLIC_BUCKETS=vehicle-images
MINIO_PRIVATE_BUCKETS=vehicle-documents
# Example when customer images are needed:
# MINIO_PRIVATE_BUCKETS=vehicle-documents,customer-images
# Java API settings, managed in this same Compose project.
FILE_SERVICE_VEHICLE_API_KEY=local-vehicle-file-service-key
FILE_SERVICE_CUSTOMER_API_KEY=local-customer-file-service-key
VEHICLE_IMAGE_BUCKET=vehicle-images
VEHICLE_DOCUMENT_BUCKET=vehicle-documents
CUSTOMER_IMAGE_BUCKET=customer-images
FILE_SERVICE_MAX_FILE_SIZE=10MB
FILE_SERVICE_MAX_PRESIGN_EXPIRY=10m
MINIO_EUREKA_ENABLED=false
