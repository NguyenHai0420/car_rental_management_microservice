{
  "realm": "car-rental-realm",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "System Administrator"
      },
      {
        "name": "VEHICLE_OWNER",
        "description": "Vehicle Owner and Fleet Operations Staff"
      },
      {
        "name": "CUSTOMER",
        "description": "Car Rental Customer"
      },
      {
        "name": "default-roles-car-rental-realm",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "CUSTOMER"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-car-rental-realm",
    "description": "${role_default-roles}",
    "composite": true
  },
  "clients": [
    {
      "clientId": "car-rental-fe",
      "name": "Car Rental React Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*"
      }
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Admin",
      "email": "admin@carrental.vn",
      "credentials": [
        {
          "type": "password",
          "value": "123456",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-car-rental-realm",
        "ADMIN"
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "owner1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Fleet",
      "lastName": "Owner",
      "email": "owner1@carrental.vn",
      "credentials": [
        {
          "type": "password",
          "value": "123456",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-car-rental-realm",
        "VEHICLE_OWNER"
      ]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "customer1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nguyen",
      "lastName": "Van A",
      "email": "customer1@carrental.vn",
      "credentials": [
        {
          "type": "password",
          "value": "123456",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-car-rental-realm",
        "CUSTOMER"
      ]
    }
  ]
}
